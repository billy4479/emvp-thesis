use flake . -L -v

# Native-CPU codegen for local development and benchmarks.
#
# `.cargo/config.toml` used to pin `-C target-cpu=native` globally, which
# leaked into every build context including packaged (Nix) builds that must
# stay portable. Direnv does not wrap `nix build`, so packaged builds never
# see this flag, while local `cargo` invocations inside the direnv shell do.
# Any pre-set RUSTFLAGS is preserved and the flag is appended only once.
case " ${RUSTFLAGS:-} " in
  *" -C target-cpu=native "*) ;;
  *) export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C target-cpu=native" ;;
esac
